{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": false,
    "pushArgs": ["--follow-tags", "--no-verify"]
  },
  "github": {
    "release": true,
    "releaseName": "v${version}",
    "releaseNotes": "git log --pretty=format:'- %s (%h)' $(git describe --tags --abbrev=0 2>/dev/null || echo HEAD~10)..HEAD"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": [
      "cargo test"
    ],
    "after:bump": [
      "node scripts/sync-release-version.js ${version}",
      "cargo check",
      "node scripts/sync-release-version.js --check"
    ],
    "after:release": "echo Successfully released ${name} v${version}"
  }
}
